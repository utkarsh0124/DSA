    int numberOfSubmatrices(vector<vector<char>>& grid) {
        int n=grid.size(), m=grid[0].size();
        vector<vector<int>> csx(n,vector<int>(m,0)),csy(n,vector<int>(m,0));
        int ans=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                csx[i][j]=(grid[i][j]=='X');
                csy[i][j]=(grid[i][j]=='Y');
                if(i>0){
                    csx[i][j]+=csx[i-1][j];
                    csy[i][j]+=csy[i-1][j];
                }
                if(j>0){
                    csx[i][j]+=csx[i][j-1];
                    csy[i][j]+=csy[i][j-1];
                }
                if(i>0 && j>0){
                    csx[i][j]-=csx[i-1][j-1];
                    csy[i][j]-=csy[i-1][j-1];
                }
                if(csx[i][j]==csy[i][j] && csx[i][j]>0) ans++;
            }
        }
        return ans;
    }
